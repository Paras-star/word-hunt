{
  "expo": {
    "name": "Word Hunt: Mystery Dumplings",
    "slug": "word-hunt",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wordhunt",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f0f0f3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paras.wordhunt"
    },
    "android": {
      "package": "com.paras.wordhunt",
      "adaptiveIcon": {
        "backgroundColor": "#f0f0f3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9827389269181842~4120089237",
          "iosAppId": "ca-app-pub-9827389269181842~4120089237"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
